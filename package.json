{
  "name": "@kontourai/relay",
  "version": "0.6.0",
  "description": "Portable, provider-neutral model invocation contracts, adapters, and conformance tools",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./anthropic": {
      "types": "./dist/src/anthropic.d.ts",
      "import": "./dist/src/anthropic.js"
    },
    "./ai-sdk": {
      "types": "./dist/src/ai-sdk.d.ts",
      "import": "./dist/src/ai-sdk.js"
    },
    "./process": {
      "types": "./dist/src/process.d.ts",
      "import": "./dist/src/process.js"
    },
    "./claude-code": {
      "types": "./dist/src/claude-code.d.ts",
      "import": "./dist/src/claude-code.js"
    },
    "./codex": {
      "types": "./dist/src/codex.d.ts",
      "import": "./dist/src/codex.js"
    },
    "./opencode": {
      "types": "./dist/src/opencode.d.ts",
      "import": "./dist/src/opencode.js"
    },
    "./runtime-profile": {
      "types": "./dist/src/runtime-profile.d.ts",
      "import": "./dist/src/runtime-profile.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "CONTEXT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "verify": "npm run typecheck && npm test && npm pack --dry-run",
    "veritas:readiness": "veritas readiness --working-tree"
  },
  "peerDependencies": {
    "@ai-sdk/provider": ">=3.0.0",
    "@anthropic-ai/sdk": ">=0.40.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.4",
    "@kontourai/veritas": "^1.3.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/relay.git"
  }
}
